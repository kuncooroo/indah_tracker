# =============================================================================
# Indah Tracker — Environment
# Salin ke `.env` (local) atau set di panel hosting (production).
# Jangan commit file `.env` yang berisi secret asli.
# =============================================================================

# --- Wajib (local & production) ---------------------------------------------
DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/indah_tracker"

# Secret session NextAuth. Production: WAJIB string acak panjang (bukan contoh).
AUTH_SECRET="ganti-dengan-secret-acak-panjang"
NEXTAUTH_SECRET="ganti-dengan-secret-acak-panjang"

# --- Local development ------------------------------------------------------
# Pakai URL lokal port 3001 (jangan bentrok dengan katalog PWA di 3000).
NEXTAUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Indah Tracker"

# Upload lokal → folder public/uploads (relative URL /uploads/...)
# UPLOAD_DIR=   # default: <project>/public/uploads
# UPLOAD_PUBLIC_BASE_URL=  # kosong di local = path relatif

# API key untuk generate tracking dari katalog PWA / ERP
TRACKER_API_KEY="dev-tracker-api-key"

# Outbound webhook saat status/progress berubah (opsional)
# WEBHOOK_URL="https://erp.example.com/hooks/indah-tracker"
# WEBHOOK_SECRET="ganti-hmac-secret"
# WEBHOOK_TIMEOUT_MS=8000

# Seed admin (hanya untuk npm run db:seed di local)
SEED_ADMIN_EMAIL="admin@tracker.local"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="Tracker Admin"

# Backup DB (npm run db:backup)
# BACKUP_DIR=backups
# BACKUP_KEEP_DAYS=14

# Rate limit /api/track (opsional — nilai default sudah aman untuk single instance)
# TRACK_RATE_LIMIT_IP=60
# TRACK_RATE_LIMIT_IP_WINDOW_MS=60000
# TRACK_RATE_LIMIT_PHONE_FAIL=8
# TRACK_RATE_LIMIT_PHONE_WINDOW_MS=900000

# --- Reminder deadline (Fase 3) ---------------------------------------------
# Ambang "due soon" (hari). Bisa juga diubah di /admin/settings (DB).
REMINDER_SOON_DAYS=2
# Secret untuk /api/cron/deadline-reminders (wajib di production)
CRON_SECRET="ganti-cron-secret"

# Email digest ke admin (nodemailer / SMTP)
REMINDER_EMAIL_ENABLED=true
# REMINDER_EMAIL_TO="ops@indahmesin.com,admin@indahmesin.com"  # kosong = semua Admin.email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Indah Tracker <noreply@indahmesin.com>"

# Opsional: Telegram bot untuk admin
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Monitoring (opsional) ---------------------------------------------------
# Error tracking — kosong = no-op
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.05
# Uptime: GET /api/health (200 = DB ok, 503 = down). Detail: Bearer CRON_SECRET

# =============================================================================
# Production checklist (isi di server / panel, JANGAN tiru nilai local)
# =============================================================================
# DATABASE_URL=mysql://USER:PASS@HOST:3306/indah_tracker
# AUTH_SECRET=<openssl rand -base64 32>
# NEXTAUTH_SECRET=<sama dengan AUTH_SECRET atau terpisah>
# NEXTAUTH_URL=https://tracker.indahmesin.com
# NEXT_PUBLIC_APP_URL=https://tracker.indahmesin.com
# TRACKER_API_KEY=<api-key-kuat-unik>
# UPLOAD_DIR=/var/www/indah_tracker/uploads   # opsional, jika di luar public/
# UPLOAD_PUBLIC_BASE_URL=https://tracker.indahmesin.com  # agar URL foto absolut
# CRON_SECRET=<secret-kuat>
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NODE_ENV=production

# Uptime: monitor GET https://tracker.../api/health (expect 200)
