generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum ShipmentStatus {
  CREATED
  IN_PROGRESS
  QUALITY_CHECK
  READY_TO_SHIP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ProgressTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Admin {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      AdminRole @default(ADMIN)
  active    Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([active])
}

model WbsTemplate {
  id            String  @id @default(uuid())
  name          String
  description   String? @db.Text
  estimatedDays Int     @default(30)
  active        Boolean @default(true)

  items     WbsTemplateItem[]
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WbsTemplateItem {
  id         String      @id @default(uuid())
  templateId String
  template   WbsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  parentId String?
  parent   WbsTemplateItem?  @relation("WbsTemplateTree", fields: [parentId], references: [id], onDelete: Cascade)
  children WbsTemplateItem[] @relation("WbsTemplateTree")

  title          String
  sortOrder      Int  @default(0)
  estimatedHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
  @@index([parentId])
}

/// Job tracking (nomor untuk customer) — setara Order di PWA
model Shipment {
  id              String         @id @default(uuid())
  trackingNumber  String         @unique
  externalOrderId String? @unique
  orderNumber     String?
  customerName    String?
  companyName     String?
  phone           String?
  phoneLast4      String?
  status          ShipmentStatus @default(CREATED)
  progressPercent Decimal        @default(0) @db.Decimal(5, 2)
  note            String?        @db.Text

  wbsTemplateId    String?
  wbsTemplate      WbsTemplate? @relation(fields: [wbsTemplateId], references: [id], onDelete: SetNull)
  estimatedDays    Int?
  estimatedEndDate DateTime?
  deliveredAt      DateTime?

  progressTasks ProgressTask[]
  deadlineNotifications DeadlineNotificationLog[]
  activityLogs ActivityLog[]

  /// Soft-delete / arsip — null = aktif di list & track publik
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([phoneLast4])
  @@index([wbsTemplateId])
  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, status])
  @@index([status, estimatedEndDate])
}

model ProgressTask {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ProgressTask?  @relation("ProgressTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ProgressTask[] @relation("ProgressTree")

  title         String
  sortOrder     Int                @default(0)
  weightPercent Decimal            @db.Decimal(5, 2)
  status        ProgressTaskStatus @default(NOT_STARTED)

  estimatedDays  Int?
  estimatedHours Int?
  actualHours    Int?

  startedAt   DateTime?
  completedAt DateTime?
  note        String? @db.Text

  photos ProgressPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentId])
  @@index([parentId])
  @@index([status])
  @@index([shipmentId, status])
  @@index([shipmentId, parentId])
}

model ProgressPhoto {
  id        String       @id @default(uuid())
  taskId    String
  task      ProgressTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  url       String       @db.Text
  caption   String?
  createdAt DateTime     @default(now())

  @@index([taskId])
}

/// Key-value settings (mis. REMINDER_SOON_DAYS)
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Anti-spam: maks 1 notifikasi per shipment per channel per hari (WIB)
model DeadlineNotificationLog {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  kind       String // overdue | due_soon
  channel    String // email | telegram
  dayKey     String // YYYY-MM-DD (Asia/Jakarta)
  createdAt  DateTime @default(now())

  @@unique([shipmentId, channel, dayKey])
  @@index([dayKey])
  @@index([shipmentId])
}

/// Jejak perubahan (audit) per shipment
model ActivityLog {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  action     String // SHIPMENT_CREATED | STATUS_CHANGED | TASK_UPDATED | ...
  summary    String // ringkas untuk admin
  publicText String? // versi aman untuk track publik (null = jangan tampil publik)

  actorType  String // admin | api | system
  actorId    String?
  actorName  String?
  actorEmail String?

  beforeJson String? @db.Text
  afterJson  String? @db.Text
  metaJson   String? @db.Text

  createdAt DateTime @default(now())

  @@index([shipmentId, createdAt])
  @@index([action])
  @@index([createdAt])
}
